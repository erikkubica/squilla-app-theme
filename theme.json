{
  "slug":        "squilla",
  "name":        "Squilla",
  "version":     "0.1.0",
  "description": "The official Squilla marketing, marketplace, and docs theme.",
  "author":      "Squilla Team",

  "styles":  [
    { "handle": "theme-css", "src": "styles/theme.css", "position": "head" }
