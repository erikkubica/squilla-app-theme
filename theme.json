  "assets": [
    { "key": "showcase-squilla",          "src": "images/showcase-squilla.jpg",          "alt": "squilla.app marketing site screenshot",          "width": 1440, "height": 900 },
    { "key": "showcase-hello-vietnam",    "src": "images/showcase-hello-vietnam.jpg",    "alt": "Hello Vietnam demo theme screenshot",            "width": 1440, "height": 900 },
    { "key": "showcase-curriculum-vitae", "src": "images/showcase-curriculum-vitae.jpg", "alt": "Curriculum Vitae demo theme screenshot",         "width": 1440, "height": 900 },
