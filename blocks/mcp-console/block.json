{
  "category": "squilla",
  "description": "Two-column hero-of-the-second-fold: left side has MCP showcase copy + 4 stat tiles + replay/pause controls, right side is an animated 'live' MCP console that types out a transcript line-by-line. Stats and transcript are repeaters — editors can change the demo without touching code.",
  "fields": [
    {
      "name": "eyebrow",
      "title": "Eyebrow",
      "type": "string"
    },
    {
      "name": "heading",
      "title": "Heading (HTML)",
      "type": "richtext"
    },
    {
      "name": "lead",
      "title": "Lead paragraph",
      "type": "textarea"
    },
    {
      "description": "Four tiles render in a 2x2 grid. Show value first, label second.",
      "fields": [
        {
          "name": "value",
          "title": "Value",
          "type": "string"
        },
        {
          "name": "label",
          "title": "Label",
          "type": "string"
        }
      ],
      "name": "stats",
      "title": "Stat tiles",
      "type": "array"
    },
    {
      "name": "replay_label",
      "title": "Replay button label",
      "type": "string"
    },
    {
      "name": "pause_label",
      "title": "Pause button label",
      "type": "string"
    },
    {
      "name": "all_link",
      "title": "View-all link",
      "type": "link"
    },
    {
      "description": "The MCP URL shown in the console title bar (e.g. mcp://squilla.local).",
      "name": "endpoint",
      "title": "Endpoint label (header)",
      "type": "string"
    },
    {
      "name": "session_id",
      "title": "Session ID (header)",
      "type": "string"
    },
    {
      "name": "capabilities",
      "title": "Capabilities label",
      "type": "string"
    },
    {
      "description": "Each line has a type t (sys|user|plan|call|res|done) and content. For 'call', also fill tool/args_text/dur/color.",
      "fields": [
        {
          "name": "t",
          "options": [
            "sys",
            "user",
            "plan",
            "call",
            "res",
            "done"
          ],
          "title": "Type",
          "type": "select"
        },
        {
          "name": "text",
          "title": "Text (sys/user/plan/res/done)",
          "type": "string"
        },
        {
          "name": "tool",
          "title": "Tool name (call)",
          "type": "string"
        },
        {
          "description": "Pre-formatted arg string, e.g. 'tags: [\"recipe\",\"food\"]'.",
          "name": "args_text",
          "title": "Args text (call)",
          "type": "string"
        },
        {
          "name": "dur",
          "title": "Duration ms (call)",
          "type": "number"
        },
        {
          "name": "color",
          "options": [
            "teal",
            "violet",
            "magenta",
            "coral",
            "lime",
            "amber"
          ],
          "title": "Tool color (call)",
          "type": "select"
        }
      ],
      "name": "transcript",
      "title": "Transcript",
      "type": "array"
    }
  ],
