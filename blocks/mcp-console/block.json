{
  "slug": "mcp-console",
  "name": "Live MCP console",
  "description": "Two-column hero-of-the-second-fold: left side has MCP showcase copy + 4 stat tiles + replay/pause controls, right side is an animated 'live' MCP console that types out a transcript line-by-line. Stats and transcript are repeaters — editors can change the demo without touching code.",
  "category": "squilla",
  "field_schema": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "type": "text"
    },
    {
      "key": "heading",
      "label": "Heading (HTML)",
      "type": "richtext"
    },
    {
      "key": "lead",
      "label": "Lead paragraph",
      "type": "textarea"
    },
    {
      "key": "stats",
      "label": "Stat tiles",
      "type": "repeater",
      "help": "Four tiles render in a 2x2 grid. Show value first, label second.",
      "sub_fields": [
        {
          "label": "Value",
          "type": "text",
          "key": "value"
        },
        {
          "label": "Label",
          "type": "text",
          "key": "label"
        }
      ]
    },
    {
      "key": "replay_label",
      "label": "Replay button label",
      "type": "text"
    },
    {
      "key": "pause_label",
      "label": "Pause button label",
      "type": "text"
    },
    {
      "key": "all_link",
      "label": "View-all link",
      "type": "link"
    },
    {
      "key": "endpoint",
      "label": "Endpoint label (header)",
      "type": "text",
      "help": "The MCP URL shown in the console title bar (e.g. mcp://squilla.local)."
    },
    {
      "key": "session_id",
      "label": "Session ID (header)",
      "type": "text"
    },
    {
      "key": "capabilities",
      "label": "Capabilities label",
      "type": "text"
    },
    {
      "key": "transcript",
      "label": "Transcript",
      "type": "repeater",
      "help": "Each line has a type t (sys|user|plan|call|res|done) and content. For 'call', also fill tool/args_text/dur/color.",
      "sub_fields": [
        {
          "label": "Type",
          "type": "select",
          "options": [
            "sys",
            "user",
            "plan",
            "call",
            "res",
            "done"
          ],
          "key": "t"
        },
        {
          "label": "Text (sys/user/plan/res/done)",
          "type": "text",
          "key": "text"
        },
        {
          "label": "Tool name (call)",
          "type": "text",
          "key": "tool"
        },
        {
          "label": "Args text (call)",
          "type": "text",
          "help": "Pre-formatted arg string, e.g. 'tags: [\"recipe\",\"food\"]'.",
          "key": "args_text"
        },
        {
          "label": "Duration ms (call)",
          "type": "number",
          "key": "dur"
        },
        {
          "label": "Tool color (call)",
          "type": "select",
          "options": [
            "teal",
            "violet",
            "magenta",
            "coral",
            "lime",
            "amber"
          ],
          "key": "color"
        }
      ]
    }
  ],
  "test_data": {
    "lead": "Squilla exposes ~50 Model Context Protocol tools across 15 domains. An AI agent can drive the entire CMS through structured API calls — create node types, seed content, activate themes, install extensions, preview rendered pages.",
    "stats": [
      {
        "label": "tools",
        "value": "~50"
      },
      {
        "label": "domains",
        "value": "15"
      },
      {
        "label": "capability gates",
        "value": "24"
      },
      {
        "label": "avg call latency",
        "value": "32ms"
      }
    ],
    "eyebrow": "§ MCP showcase",
    "heading": "Every operation<br/>is a tool an<br/>AI can call.",
    "all_link": {
      "url": "/docs/mcp-tools",
      "text": "view all 50 tools →",
      "target": "_self"
    },
    "endpoint": "mcp://squilla.local",
    "session_id": "session a4f9e2",
    "transcript": [
      {
        "t": "sys",
        "text": "agent connected · session a4f9e2 · capabilities=24/24 · tools=50"
      },
      {
        "t": "user",
        "text": "Build a recipe blog with 10 example recipes."
      },
      {
        "t": "plan",
        "text": "6-step plan: theme → activation → nodetype → seed → preview → menu"
      },
      {
        "t": "call",
        "dur": 14,
        "tool": "core.theme.list",
        "color": "teal",
        "args_text": "tags: [\"recipe\", \"food\"]"
      },
      {
        "t": "res",
        "text": "found 3 themes · selecting hello-vietnam (best schema match)"
      },
      {
        "t": "call",
        "dur": 31,
        "tool": "core.theme.activate",
        "color": "lime",
        "args_text": "id: \"hello-vietnam\""
      },
      {
        "t": "res",
        "text": "activated · seeded 4 node types · 1 menu · 12 settings"
      },
      {
        "t": "call",
        "dur": 22,
        "tool": "core.nodetype.create",
        "color": "violet",
        "args_text": "slug: \"recipe\", fields: 7"
      },
      {
        "t": "res",
        "text": "recipe type registered · table content_recipes created"
      },
      {
        "t": "call",
        "dur": 84,
        "tool": "core.node.create",
        "color": "magenta",
        "args_text": "type: \"recipe\", batch: 10"
      },
      {
        "t": "res",
        "text": "10 recipes drafted · ids=[101..110]"
      },
      {
        "t": "call",
        "dur": 19,
        "tool": "core.render.node_preview",
        "color": "coral",
        "args_text": "url: \"/recipes/scallops\""
      },
      {
        "t": "res",
        "text": "rendered · 4.1KB · ttfb=18ms · ok"
      },
      {
        "t": "call",
        "dur": 11,
        "tool": "core.menu.update",
        "color": "amber",
        "args_text": "items: 4"
      },
      {
        "t": "res",
        "text": "navigation wired · publishing…"
      },
      {
        "t": "done",
        "text": "site live at http://localhost:3000 · 10 recipes published in 12.4s"
      }
    ],
    "pause_label": "❚❚ pause",
    "capabilities": "capabilities 24/24",
    "replay_label": "↻ replay"
  }
}
