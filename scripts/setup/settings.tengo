// setup/settings.tengo — Deprecated. Theme settings are now managed via the
// admin Theme Settings UI, declared in theme.json's settings_pages and
// stored under theme:squilla:<page>:<field>. See settings/*.json for the
// full schema. Defaults flow through ThemeSettingsField.Default in those
// JSON files; this script no longer seeds anything.
//
// Kept as an empty entry point so any cached references to the slug stay
// valid; safe to delete the file once no extension still references it.

log := import("core/log")

export {
    run: func() {
        log.info("[squilla:setup] settings now sourced from settings/*.json")
    }
}
