// setup/nodetypes.tengo — Custom node types for the Squilla theme.
//
// Three new node types:
//   - extension     : a marketplace listing (gRPC plugin or Tengo extension)
//   - theme         : a marketplace listing for a theme
//   - documentation : a documentation page (lives under /docs/...)
//
// Defaults `page` and `post` are provided by core and are not redeclared.

nodetypes := import("core/nodetypes")
log       := import("core/log")

export {
    run: func() {
        log.info("[squilla:setup] registering node types")

        // ─── Extension ────────────────────────────────────────
        nodetypes.register({
            slug:         "extension",
            label:        "Extension",
            label_plural: "Extensions",
            icon:         "puzzle",
            description:  "A Squilla extension (gRPC plugin or Tengo).",
            url_prefixes: { en: "extensions" },
            fields: [
                { name: "tagline",     title: "Tagline",          type: "string",     description: "One-line summary shown in catalog cards." },
                { name: "source",      title: "Source",           type: "term",     taxonomy: "source", term_node_type: "extension", description: "official | community | verified" },
                { name: "kind",        title: "Kind",             type: "select",   options: ["gRPC plugin", "Tengo only", "Tengo + Go", "Manifest only"], initialValue: "gRPC plugin", description: "Implementation type — affects the small label in the bottom-right of the catalog cell." },
                { name: "version",     title: "Version",          type: "string",     description: "Semver, e.g. 1.0.0" },
                { name: "author",      title: "Author",           type: "string" },
                { name: "homepage",    title: "Homepage URL",     type: "string" },
                { name: "repository",  title: "Repository URL",   type: "string" },
                { name: "icon",        title: "Icon",             type: "image",    description: "Square icon shown in cards." },
                { name: "screenshot",  title: "Screenshot",       type: "image",    description: "Hero screenshot for the detail page." },
                { name: "routes",      title: "HTTP Routes",      type: "number",   description: "How many public/admin routes the extension registers (for catalog stats)." },
                { name: "tables",      title: "Owned DB Tables",  type: "array", fields: [ { name: "name", title: "Table name", type: "string" } ], description: "PostgreSQL tables this extension owns (rendered in the homepage 'OWNS' chip strip)." },
                { name: "downloads",   title: "Download Count",   type: "number" },
                { name: "rating",      title: "Rating (0-5)",     type: "number" },
                { name: "price",       title: "Price (USD)",      type: "number",   description: "0 for free." },
                { name: "featured",    title: "Featured",         type: "toggle",   description: "Show on the homepage / featured carousel." }
            ]
        })

        // ─── Theme ────────────────────────────────────────────
        nodetypes.register({
            slug:         "theme",
            label:        "Theme",
            label_plural: "Themes",
            icon:         "palette",
            description:  "A Squilla theme available in the marketplace.",
            url_prefixes: { en: "themes" },
            fields: [
                { name: "tagline",     title: "Tagline",          type: "string" },
                { name: "source",      title: "Source",           type: "term",     taxonomy: "source", term_node_type: "theme" },
                { name: "version",     title: "Version",          type: "string" },
                { name: "author",      title: "Author",           type: "string" },
                { name: "homepage",    title: "Homepage URL",     type: "string" },
                { name: "repository",  title: "Repository URL",   type: "string" },
                { name: "preview",     title: "Preview Image",    type: "image",    description: "Card thumbnail." },
                { name: "screenshots", title: "Screenshots",      type: "gallery",  description: "Detail-page gallery." },
                { name: "downloads",   title: "Download Count",   type: "number" },
                { name: "rating",      title: "Rating (0-5)",     type: "number" },
                { name: "price",       title: "Price (USD)",      type: "number" },
                { name: "featured",    title: "Featured",         type: "toggle" }
            ]
        })

        // ─── Post (extends core "post" with custom fields) ────
        nodetypes.register({
            slug:         "post",
            label:        "Post",
            label_plural: "Posts",
            icon:         "file-text",
            description:  "A blog post.",
            fields: [
                { name: "excerpt",   title: "Excerpt",      type: "textarea", description: "1–2 sentence summary shown in lists and meta description." },
                { name: "read_time", title: "Read time",    type: "string",     description: "e.g. \"5 min read\". Shown in the post-meta strip; hidden if blank." },
                { name: "author",    title: "Author",       type: "string",     description: "Display name shown next to \"by …\" in the post-meta strip; hidden if blank." }
            ]
        })

        // ─── Documentation ────────────────────────────────────
        nodetypes.register({
            slug:         "documentation",
            label:        "Documentation",
            label_plural: "Documentation",
            icon:         "book-open",
            description:  "A documentation page.",
            url_prefixes: { en: "docs" },
            fields: [
                { name: "section",      title: "Section",         type: "term",    taxonomy: "doc_section", term_node_type: "documentation", description: "Top-level grouping in the sidebar." },
                { name: "summary",      title: "Summary",         type: "textarea", description: "1–2 sentence summary used by search results." },
                { name: "order",        title: "Sort Order",      type: "number",   description: "Lower numbers appear first within a section." },
                { name: "search_terms", title: "Search Terms",    type: "string",     description: "Extra keywords for search; comma-separated." }
            ]
        })
    }
}
