// list_extensions.tengo — query extension marketplace listings.
//   {{ filter "list_extensions" (dict "limit" 50) }}
//
// Returns: list of { id, slug, title, url, tagline, source, version, author,
//                    downloads, rating, price, featured, kind, color }.
// `source` is the slug of the source term (official | community | verified).
// `color` is the design accent for the catalog cells (cycles by index).

nodes := import("core/nodes")

input := value
if is_undefined(input) { input = {} }
limit := 50
if !is_undefined(input.limit) { limit = input.limit }

PALETTE := ["teal", "violet", "coral", "lime", "magenta", "amber"]

res := nodes.query({
    node_type: "extension",
    status:    "published",
    limit:     limit,
    order_by:  "title asc"
})

if is_error(res) {
    response = []
} else {
    out := []
    for i, n in res.nodes {
        f := n.fields_data
        if is_undefined(f) { f = {} }

        source_slug := ""
        if !is_undefined(f.source) {
            sv := f.source
            if is_string(sv) { source_slug = sv } else if !is_undefined(sv.slug) { source_slug = sv.slug }
        }

        // tables is a repeater of {name}; flatten to plain string list for templates.
        table_names := []
        if !is_undefined(f.tables) {
            for t in f.tables {
                if !is_undefined(t.name) { table_names = append(table_names, t.name) }
            }
        }

        out = append(out, {
            id:           n.id,
            slug:         n.slug,
            title:        n.title,
            url:          n.full_url,
            tagline:      f.tagline,
            source:       source_slug,
            version:      f.version,
            author:       f.author,
            downloads:    f.downloads,
            rating:       f.rating,
            price:        f.price,
            featured:     f.featured,
            kind:         f.kind,
            routes:       f.routes,
            tables:       table_names,
            tables_count: len(table_names),
            color:        PALETTE[i % len(PALETTE)]
        })
    }
    response = out
}
