// seeds/pages.tengo — Idempotent page seeds.
//
// Each page = one ContentNode (`page` node type) with `blocks_data` listing
// the design's sections in order. Pattern: existence-check by slug; don't
// overwrite editors' changes. Layout selection happens implicitly via the
// `default` layout — except docs pages (handled in seeds/docs.tengo) which
// will use the `docs` layout once layout-per-node-type wiring lands.

nodes    := import("core/nodes")
settings := import("core/settings")
log      := import("core/log")

// Per-page excerpt + SEO. meta_title doubles as the <title> SEO override;
// meta_description is the meta-description. Excerpt is also stored at the
// top-level node.excerpt for templates that fall back to it.
PAGE_META := {
    "home":         { excerpt: "An open-source, Go-based CMS designed so an AI agent can build, populate, and operate an entire website. Kernel + sovereign extensions, MCP-first, sub-50ms TTFB.",            meta_title: "Squilla — The CMS where AI does the work.",                                meta_description: "Open-source, Go-based, AI-native CMS. Kernel + extension architecture, MCP-driven, sub-50ms public renders. GPL-3.0, no telemetry." },
    "features":     { excerpt: "Every Squilla capability mapped to the kernel module or built-in extension that ships it. No wishlist — every line is wired and on GitHub.",                                  meta_title: "Features — Squilla",                                                        meta_description: "Content modelling, MCP control surface, theme engine, capability-scoped extensions, sub-50ms renders. The full feature list with the receipts." },
    "architecture": { excerpt: "How Squilla's kernel + extension model maps to a request lifecycle: HTTP → kernel → CoreAPI → gRPC plugin bus → PostgreSQL JSONB.",                                            meta_title: "Architecture — Squilla",                                                    meta_description: "The kernel-vs-extension split, request lifecycle, hot activation, capability scopes, and where every byte of work happens." },
    "extensions":   { excerpt: "The eight reference extensions that ship with Squilla v0.1.0 — media, forms, email, sitemap, content blocks, SMTP / Resend providers, and the hello demo.",                    meta_title: "Extensions — Squilla",                                                      meta_description: "Browse the eight reference extensions that ship with Squilla. Each one owns its tables, admin UI, and gRPC plugin." },
    "themes":       { excerpt: "Squilla themes ship layouts, partials, content blocks, and a Tengo seed script. Activate one and the CMS reorganises itself — no restart.",                                  meta_title: "Themes — Squilla",                                                          meta_description: "Three reference themes for marketing sites, single-page apps, and CV pages. Layouts, partials, blocks, seeded content — all via Tengo." },
    "about":        { excerpt: "Why Squilla exists, who builds it, and the principles that decide what goes in the kernel vs. an extension.",                                                                  meta_title: "About — Squilla",                                                           meta_description: "An open-source CMS built around the bet that AI agents are first-class users. Principles, history, and the people behind the project." },
    "blog":         { excerpt: "Updates, deep dives, and field notes from the Squilla project — kernel design, extension authoring, performance budgets, and migration guides.",                              meta_title: "Blog — Squilla",                                                            meta_description: "Engineering posts and product notes from the Squilla project. New extensions, kernel internals, MCP workflows, performance, and migrations." },
    "showcase":     { excerpt: "Real sites running on Squilla — squilla.app itself, plus the reference Hello-Vietnam landing and the CV theme.",                                                              meta_title: "Showcase — Squilla",                                                        meta_description: "Live sites running on Squilla, including the marketing site you're reading and the reference themes shipped with the project." },
    "pricing":      { excerpt: "Squilla is GPL-3.0 and free to self-host. Optional commercial licensing and managed hosting for teams that want a vendor on the hook.",                                       meta_title: "Pricing — Squilla",                                                         meta_description: "Free and open-source under GPL-3.0. Optional commercial licensing and managed hosting if you'd rather have someone on the hook." },
    "legal":        { excerpt: "License, privacy, terms, security, and brand for squilla.app and the Squilla project. Plain text, no surprises.",                                                              meta_title: "Legal — Squilla",                                                           meta_description: "License, privacy, terms, security, and brand for squilla.app and the Squilla project. Plain text, no surprises." },
    "changelog":    { excerpt: "Versioned release notes for the Squilla kernel, reference extensions, and the Squilla theme.",                                                                                meta_title: "Changelog — Squilla",                                                       meta_description: "Versioned release notes for the Squilla kernel, the reference extensions, and the marketing theme." },
    "contact":      { excerpt: "How to reach the Squilla maintainers — GitHub issues for bugs and features, GitHub Discussions for everything else.",                                                          meta_title: "Contact — Squilla",                                                         meta_description: "Open an issue for bugs and features, or start a thread on GitHub Discussions for ideas, questions, and showcases." }
}

ensure_page := func(slug, title, blocks) {
    res := nodes.query({ node_type: "page", slug: slug, limit: 1 })
    if is_error(res) || res.total > 0 {
        if !is_error(res) && res.total > 0 { return res.nodes[0].id }
        return 0
    }
    meta := PAGE_META[slug]
    if is_undefined(meta) { meta = { excerpt: "", meta_title: title, meta_description: "" } }
    n := nodes.create({
        title:        title,
        slug:         slug,
        node_type:    "page",
        status:       "published",
        excerpt:      meta.excerpt,
        seo_settings: {
            meta_title:       meta.meta_title,
            meta_description: meta.meta_description
        },
        blocks_data: blocks
    })
    if is_error(n) {
        log.warn("[squilla:seed] failed to create page: " + slug)
        return 0
    }
    return n.id
}

export {
    run: func() {
        log.info("[squilla:seed] seeding pages with design blocks")

        // ─── HOME ─────────────────────────────────────────────
        home_id := ensure_page("home", "Squilla — The CMS where AI does the work.", [
            { type: "sq-hero",          fields: {
                eyebrow:   "AI-native · kernel-class · mantis-shrimp-fast",
                headline:  "The CMS where AI does the work.",
                lead:      "Squilla is an open-source, Go-based CMS designed around one idea: an AI agent should be able to build, populate, and operate an entire website with zero hand-holding. Every operation lives behind an <span style=\"color: var(--accent)\">MCP tool</span>. Every feature lives in a sovereign gRPC extension. The kernel stays small. The shrimp stays fast.",
                primary:   { text: "docker compose up", url: "/docs/installation",                  target: "_self" },
                secondary: { text: "View on GitHub",    url: "https://github.com/erikkubica/squilla", target: "_blank" },
                tertiary:  { text: "read the brief →",  url: "/about",                              target: "_self" }
            } },
            { type: "pillars",          fields: {
                p1_title: "AI-Native, MCP-First",
                p1_body:  "Roughly 50 MCP tools across 15 domains. An agent registers custom node types, seeds content, activates themes, manages extensions, renders previews — all through structured calls. No filesystem access, no shell, no human-in-the-loop required.",
                p1_code:  "core.node.create({\n  type: \"recipe\",\n  fields: {…}\n})",
                p2_title: "Kernel + Extensions",
                p2_body:  "The core is a minimal kernel: nodes, rendering, auth, CoreAPI, event bus. Anything feature-specific (media, email, forms, sitemap, blocks) is a sovereign gRPC extension that owns its full stack — its own tables, business logic, admin UI, migrations.",
                p2_code:  "$ ls extensions/\nforms/        media-manager/\nemail-manager/ sitemap-generator/\ncontent-blocks/ resend-provider/",
                p3_title: "Sub-millisecond strike",
                p3_body:  "Atomic, hot-swapped config maps. Pre-resolved layout trees. JSONB + GIN-indexed content. PostgreSQL connection pooling. The kernel gets out of the way so the response gets out the door — fast.",
                p3_code:  "GET /docs/quickstart\n→ 200 OK\n  template = pre-resolved\n  query    = single round-trip"
            } },
            { type: "arch-diagram",     fields: {
                eyebrow:    "§ architecture",
                heading:    "A kernel<br/>for kernels.",
                lead:       "Squilla's architecture is borrowed from operating systems: the kernel does the minimum required to be a CMS, and everything else is a sovereign extension. Disable an extension and there is no dead code in core. Add a new extension and it brings its own database tables, HTTP routes, admin UI pages, scripts, and migrations.",
                rule_label: "HARD RULE",
                rule:       "If disabling an extension would leave dead code in core, that code belongs in the extension, not the kernel.",
                layers: [
                    { label: "PUBLIC WEB",       desc: "Fiber HTTP · pre-resolved layouts · cached",              color: "ink-3" },
                    { label: "MCP SERVER",       desc: "Model Context Protocol · ~50 tools · stdio + http",       color: "coral" },
                    { label: "KERNEL (CoreAPI)", desc: "nodes · rendering · auth · event bus · capability gates", color: "teal" },
                    { label: "gRPC PLUGIN BUS",  desc: "HashiCorp go-plugin · bidirectional · GRPCBroker",        color: "violet" },
                    { label: "EXTENSIONS",       desc: "media · forms · email · sitemap · blocks · providers",     color: "magenta" },
                    { label: "POSTGRESQL 16",    desc: "JSONB · GIN indexes · per-extension migrations · pooling", color: "lime" }
                ],
                legend: [
                    { key: "kernel",     val: "internal/cms · internal/coreapi" },
                    { key: "extensions", val: "extensions/*/cmd/plugin" },
                    { key: "themes",     val: "themes/*/scripts/theme.tengo" }
                ]
            } },
            { type: "mcp-console",      fields: {
                eyebrow:      "§ MCP showcase",
                heading:      "Every operation<br/>is a tool an<br/>AI can call.",
                lead:         "Squilla exposes a Model Context Protocol surface across 15 domains — nodes, node types, taxonomies, terms, settings, events, menus, media, themes, extensions, layouts, blocks, render, users, files. An agent drives the entire CMS through structured tool calls, with capability scopes enforced server-side.",
                stats: [
                    { value: "~50",          label: "tools" },
                    { value: "15",           label: "domains" },
                    { value: "24",           label: "capability gates" },
                    { value: "stdio + http", label: "transports" }
                ],
                replay_label: "↻ replay",
                pause_label:  "❚❚ pause",
                all_link:     { text: "browse the MCP API →", url: "/docs/api-mcp", target: "_self" },
                endpoint:     "mcp://squilla.local",
                session_id:   "session a4f9e2",
                capabilities: "capabilities 24/24",
                transcript: [
                    { t: "sys",  text: "agent connected · session a4f9e2 · capabilities=24/24 · tools=50" },
                    { t: "user", text: "Build a recipe blog with 10 example recipes." },
                    { t: "plan", text: "6-step plan: theme → activation → nodetype → seed → preview → menu" },
                    { t: "call", tool: "core.theme.list",          args_text: "tags: [\"recipe\", \"food\"]",      dur: 14, color: "teal" },
                    { t: "res",  text: "found 4 themes · selecting hello-vietnam (best schema match)" },
                    { t: "call", tool: "core.theme.activate",      args_text: "id: \"hello-vietnam\"",             dur: 31, color: "lime" },
                    { t: "res",  text: "activated · seeded 4 node types · 1 menu · 12 settings" },
                    { t: "call", tool: "core.nodetype.create",     args_text: "slug: \"recipe\", fields: 7",       dur: 22, color: "violet" },
                    { t: "res",  text: "recipe type registered · JSONB GIN index live" },
                    { t: "call", tool: "core.node.create",         args_text: "type: \"recipe\", batch: 10",       dur: 84, color: "magenta" },
                    { t: "res",  text: "10 recipes drafted · ids=[101..110]" },
                    { t: "call", tool: "core.render.node_preview", args_text: "slug: \"caramelised-scallops\"",   dur: 19, color: "coral" },
                    { t: "res",  text: "rendered · ok" },
                    { t: "call", tool: "core.menu.upsert",         args_text: "slug: \"main-nav\", items: 4",      dur: 11, color: "amber" },
                    { t: "res",  text: "navigation wired · publishing…" },
                    { t: "done", text: "site live · 10 recipes published in 12.4s · zero filesystem touches" }
                ]
            } },
            { type: "extensions-grid",  fields: {
                eyebrow: "§ built-in extensions",
                heading: "Seven extensions in the box.<br/>Built like a third-party would build them.",
                lead:    "Squilla ships with reference extensions that exercise every part of the extension API — gRPC plugins, Tengo-only providers, manifest-only block libraries. They are not core code in disguise; they're the same extensions you'd build yourself.",
                cta:     { text: "build your own extension", url: "/docs/extension-grpc", target: "_self" }
            } },
            { type: "theme-showcase",   fields: {
                eyebrow: "§ themes",
                heading: "Themes are<br/>sovereign too.",
                lead:    "A Squilla theme is a self-contained package: layouts, partials, content blocks, assets, plus a Tengo seed script that registers node types, taxonomies, and seeds pages on activation. No restart, no manual install — activate and the CMS reorganises itself around the theme.",
                rows: [
                    { key: "Layouts",  value: "Page-level templates. Receive .node · .app · .user",                                                       color: "teal" },
                    { key: "Partials", value: "Reusable fragments included via {{renderLayoutBlock}}. Same context plus .partial",                        color: "violet" },
                    { key: "Blocks",   value: "Atomic content units. Self-contained, schema-defined, render with their own field data only.",            color: "magenta" }
                ],
                callout:       "Activate a theme. The CMS reorganises itself around it. No restart.",
                code_file:     "themes/hello-vietnam/scripts/theme.tengo",
                code_language: "javascript",
                code_body:     "<pre><code>nodes    := import(\"core/nodes\")\nnodetypes := import(\"core/nodetypes\")\nevents   := import(\"core/events\")\n\n// register the recipe node type\nnodetypes.register({\n  slug: \"recipe\",\n  label: \"Recipe\",\n  field_schema: [\n    {name: \"hero_image\",   type: \"image\"},\n    {name: \"prep_minutes\", type: \"number\"},\n    {name: \"servings\",     type: \"number\"},\n    {name: \"ingredients\",  type: \"repeater\"},\n    {name: \"instructions\", type: \"richtext\"}\n  ]\n})\n\n// seed a starter recipe\nnodes.create({\n  node_type: \"recipe\",\n  title:     \"Caramelised scallops\",\n  status:    \"published\",\n  fields_data: { prep_minutes: 18, servings: 2 }\n})\n\nevents.emit(\"theme.seeded\", { theme: \"hello-vietnam\" })</code></pre>"
            } },
            { type: "perf-section",     fields: {
                eyebrow:      "§ performance",
                heading:      "Built for the metric<br/>that matters: TTFB.",
                bullets: [
                    { text: "Atomic configuration maps — hot-swapped without locks" },
                    { text: "Pre-resolved layout trees — no template lookup at request time" },
                    { text: "JSONB + GIN indexes for content — sub-millisecond field queries" },
                    { text: "PostgreSQL connection pooling via pgx — saturated under load" },
                    { text: "Eager-loaded relations — no N+1 queries on read paths" },
                    { text: "Hot theme/extension activation — no restart, no downtime" }
                ],
                ttfb_label:   "LIVE TTFB · /docs/quickstart",
                ttfb_initial: 23,
                budget_text:  "kernel budget",
                tag_text:     "single-digit ms goal",
                stats: [
                    { label: "p50", value: "fast" },
                    { label: "p95", value: "still fast" },
                    { label: "p99", value: "yes really" }
                ]
            } },
            { type: "footer-cta",       fields: {
                eyebrow: "§ try it",
                heading: "Three minutes from publishing.",
                console_lines: [
                    { html: "<span style=\"color: var(--ink-3)\">$</span> <span style=\"color: var(--accent)\">git clone</span> github.com/erikkubica/squilla" },
                    { html: "<span style=\"color: var(--ink-3)\">$</span> <span style=\"color: var(--accent)\">docker compose up</span> --build" },
                    { html: "<span style=\"color: var(--ink-3)\">→ app at localhost:8099 · admin login printed to logs</span>" }
                ],
                lead:      "Clone, compose-up, log in with the password printed to stdout. Seven extensions active, one theme seeded, MCP server listening. Welcome to the shrimp.",
                primary:   { text: "docker compose up", url: "/docs/installation",                    target: "_self" },
                secondary: { text: "View on GitHub ↗",   url: "https://github.com/erikkubica/squilla", target: "_blank" }
            } }
        ])
        // homepage_node_id is an internal pointer the kernel uses to resolve
        // GET /. Always re-set so deleting + re-seeding 'home' doesn't leave
        // the setting pointing at a deleted node. Editors don't change this
        // directly (the admin homepage picker writes the same key, but only
        // after manual reassignment, which is fine to clobber on activation).
        if home_id > 0 {
            settings.set("homepage_node_id", string(home_id))
        }

        // ─── FEATURES ─────────────────────────────────────────
        ensure_page("features", "Features", [
            { type: "page-header", fields: {
                eyebrow: "§ features",
                title:   "Every capability, with the receipts.",
                sub:     "Squilla isn't a wishlist. Each feature here is wired into the kernel or a built-in extension you can read on GitHub. The list is short on purpose."
            }},
            { type: "features-grid", fields: {
                groups: [
                    { category: "Content", items: [
                        { name: "Node types",   desc: "Custom post types via MCP or Tengo. JSONB storage, GIN-indexed.",          stat: "metadata-only" },
                        { name: "Versioning",   desc: "Drafts, publishes, and per-field history with restore.",                    stat: "field-level" },
                        { name: "Taxonomies",   desc: "Hierarchical and flat. Term metadata. Faceted query API.",                  stat: "JSON facets" },
                        { name: "Menus",        desc: "Tree menus with deep-link tracking and route validation.",                  stat: "route-aware" }
                    ] },
                    { category: "Editor", items: [
                        { name: "VDUS admin",       desc: "Server-driven UI. Boot manifest, layout trees, SSE updates.",        stat: "no client routing" },
                        { name: "Live preview",     desc: "Renders the actual layout tree, not an iframe simulation.",            stat: "real DOM" },
                        { name: "Capability gates", desc: "Fine-grained capability strings; per-extension required set.",         stat: "server-enforced" },
                        { name: "Block authoring",  desc: "Author content blocks in JSON + Go template. Live preview built in.",  stat: "JSON-defined" }
                    ] },
                    { category: "AI", items: [
                        { name: "MCP server",        desc: "stdio + http. ~50 tools across 15 domains. core.guide meta-tool.",       stat: "~50 tools" },
                        { name: "Resource URIs",     desc: "squilla://guidelines/themes, …/extensions for agent self-onboarding.",   stat: "self-describing" },
                        { name: "Decision tree",     desc: "core.guide returns goal-to-tool decision trees plus current CMS state.", stat: "state-aware" },
                        { name: "Capability scopes", desc: "Per-tool capability declarations enforced server-side; no override.",   stat: "fine-grained" }
                    ] },
                    { category: "Performance", items: [
                        { name: "Atomic config",        desc: "Hot-swapped maps. Reads never block. No lock contention.",   stat: "lock-free" },
                        { name: "Pre-resolved layouts", desc: "Layout tree compiled at activation, not request time.",       stat: "0ms lookup" },
                        { name: "Connection pooling",   desc: "pgxpool, sized to saturate under load. Per-tenant scoping.",  stat: "pgxpool" },
                        { name: "TTFB budgeted",        desc: "Single-digit ms kernel work targeted; regressions reviewed.", stat: "single-digit" }
                    ] }
                ]
            } }
        ])

        // ─── ARCHITECTURE ─────────────────────────────────────
        ensure_page("architecture", "Architecture", [
            { type: "page-header", fields: {
                eyebrow: "§ architecture",
                title:   "The kernel does six things. The extensions do everything else.",
                sub:     "Squilla borrows from operating-system design. The kernel manages content nodes, rendering, auth, the CoreAPI, the event bus, and the MCP server. Anything feature-specific is a sovereign gRPC extension."
            }},
            { type: "arch-diagram",     fields: {
                eyebrow:    "§ architecture",
                heading:    "A kernel<br/>for kernels.",
                lead:       "Squilla's architecture is borrowed from operating systems: the kernel does the minimum required to be a CMS, and everything else is a sovereign extension. Disable an extension and there is no dead code in core. Add a new extension and it brings its own database tables, HTTP routes, admin UI pages, scripts, and migrations.",
                rule_label: "HARD RULE",
                rule:       "If disabling an extension would leave dead code in core, that code belongs in the extension, not the kernel.",
                layers: [
                    { label: "PUBLIC WEB",       desc: "Fiber HTTP · pre-resolved layouts · cached",              color: "ink-3" },
                    { label: "MCP SERVER",       desc: "Model Context Protocol · ~50 tools · stdio + http",       color: "coral" },
                    { label: "KERNEL (CoreAPI)", desc: "nodes · rendering · auth · event bus · capability gates", color: "teal" },
                    { label: "gRPC PLUGIN BUS",  desc: "HashiCorp go-plugin · bidirectional · GRPCBroker",        color: "violet" },
                    { label: "EXTENSIONS",       desc: "media · forms · email · sitemap · blocks · providers",     color: "magenta" },
                    { label: "POSTGRESQL 16",    desc: "JSONB · GIN indexes · per-extension migrations · pooling", color: "lime" }
                ],
                legend: [
                    { key: "kernel",     val: "internal/cms · internal/coreapi" },
                    { key: "extensions", val: "extensions/*/cmd/plugin" },
                    { key: "themes",     val: "themes/*/scripts/theme.tengo" }
                ]
            }},
            { type: "arch-lifecycle",  fields: {
                eyebrow: "§ request lifecycle",
                heading: "From URL to bytes, in seven steps.",
                rows: [
                    { time: "01", label: "Fiber receives request", detail: "router resolves to node handler" },
                    { time: "02", label: "Layout tree lookup",     detail: "pre-resolved at activation; no DB query" },
                    { time: "03", label: "Node fetch",             detail: "JSONB query · GIN index hit · single round-trip" },
                    { time: "04", label: "Filter chain",           detail: "extensions hook into filter.apply" },
                    { time: "05", label: "Template render",        detail: "html/template with custom funcs" },
                    { time: "06", label: "Response flush",         detail: "compressed at the response writer (gzip / brotli)" },
                    { time: "07", label: "Done",                   detail: "event.emit(\"page.served\") · async" }
                ]
            } }
        ])

        // ─── EXTENSIONS (catalog) ─────────────────────────────
        ensure_page("extensions", "Extensions", [
            { type: "page-header", fields: {
                eyebrow: "§ extensions",
                title:   "A package manager, but the packages are sovereign.",
                sub:     "Each extension is a Go plugin binary, a React micro-frontend, SQL migrations, and a manifest — bundled together. The kernel never reaches inside."
            }},
            { type: "extensions-catalog", fields: {} }
        ])

        // ─── THEMES (catalog) ─────────────────────────────────
        ensure_page("themes", "Themes", [
            { type: "page-header", fields: {
                eyebrow: "§ themes",
                title:   "Self-contained presentation packages. Activate to install.",
                sub:     "Themes ship layouts, partials, content blocks, assets, and a theme.tengo seed script. Activating runs the script — registering node types, taxonomies, settings, and seeding pages — without restart."
            }},
            { type: "themes-catalog", fields: {} }
        ])

        // ─── ABOUT ────────────────────────────────────────────
        ensure_page("about", "About", [
            { type: "page-header",       fields: { eyebrow: "§ about", title: "Why Squilla exists." } },
            { type: "text-block", fields: {
                body: `<p><em>WordPress made publishing easy in 2003. It is now 2026. The web has changed. Most CMSes haven't.</em></p><p>We built Squilla because the existing options force a trade: be developer-friendly OR editor-friendly. Be fast OR flexible. Be open-source OR AI-ready. Squilla refuses the trade. The kernel does the minimum required to be a CMS, and every feature is a sovereign extension that owns its full stack.</p><p>The kernel is <span style="color: var(--accent)">Linux-small</span>. The extension model is <span style="color: var(--violet)">Debian-clean</span>. The MCP layer is <span style="color: var(--coral)">agent-native</span>. The runtime is <span style="color: var(--lime)">Go-fast</span>. The GPL-3.0 license is <span style="color: var(--magenta)">forever</span>.</p>`
            } },
            { type: "about-principles",  fields: {
                eyebrow: "§ principles",
                narrow:  false,
                items: [
                    { heading: "AI agents are first-class users.", body: "Not as a \"ChatGPT integration\". As primary operators with the same API surface humans use — the MCP server and the CoreAPI." },
                    { heading: "Performance is non-negotiable.",   body: "Pre-resolved layouts, JSONB + GIN indexes, atomic config swaps, no N+1 reads. The CMS gets out of the way." },
                    { heading: "The kernel stays small.",          body: "If disabling a feature would leave dead code in core, that feature belongs in an extension. Always." },
                    { heading: "Extensions are sovereign.",        body: "Their tables, their UI, their scripts, their migrations. The kernel never reaches inside." },
                    { heading: "One-shot setup.",                  body: "docker compose up and you're publishing. No package managers, no cron jobs, no PHP-FPM tuning, no \"first-time setup wizard\"." }
                ]
            } },
            { type: "about-team",        fields: {
                eyebrow: "§ team",
                title:   "Six humans. One of them real.",
                sub:     "<p>Squilla is built by Erik and a tireless team of \"Claude\" personas — different names, different roles, same model. The joke writes itself; the work is real. Standups are quiet.</p>",
                members: [
                    { name: "Erik Kubica", alias: "Master", role: "Founder & engineer", photo: { url: "/theme/assets/images/team-erik.jpg", alt: "Erik Kubica" }, is_ai: false },
                    { name: "Claudia",     alias: "Claude", role: "Human resources",    photo: {}, is_ai: true },
                    { name: "Fred",        alias: "Claude", role: "Software architect", photo: {}, is_ai: true },
                    { name: "Tom",         alias: "Claude", role: "Design",             photo: {}, is_ai: true },
                    { name: "Léa",         alias: "Claude", role: "QA & testing",       photo: {}, is_ai: true },
                    { name: "Max",         alias: "Claude", role: "DevOps & infra",     photo: {}, is_ai: true }
                ],
                footnote: "<p>Yes, every \"Claude\" above is the same underlying model. We give them different names because it's funnier than \"Claude (1 of 5)\" in standups, and because giving the QA persona a slightly different prompt than the architect persona genuinely changes what each one notices.</p>"
            } }
        ])

        // ─── BLOG INDEX ───────────────────────────────────────
        ensure_page("blog", "Blog", [
