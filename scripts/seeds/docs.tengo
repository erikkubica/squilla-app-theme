// seeds/docs.tengo — Documentation pages.
//
// Source of truth is seeds/docs.json (built from /docs and the codebase).
// This script loads the JSON, ensures taxonomy terms, and idempotently
// upserts every documentation node.
//
// Block strategy used in the JSON:
//   doc-content     — long prose: <h2>/<h3>/<p>/<blockquote>/<ul>/<ol>/<hr>
//                     and inline <code>/<strong>/<em>/<a>. WYSIWYG primitives.
//   doc-callout     — coloured heads-up / note / tip / danger box.
//   doc-codeblock   — IDE-style code block with file header + traffic-light dots.
//   doc-image       — figure with caption (single image).
//   doc-gallery     — figure with caption (multiple images).

nodes   := import("core/nodes")
terms   := import("core/terms")
log     := import("core/log")
assets  := import("core/assets")
helpers := import("core/helpers")

ensure_term := func(slug, name) {
    found := terms.list("documentation", "doc_section")
    if !is_error(found) {
        for t in found {
            if t.slug == slug { return true }
        }
    }
    res := terms.create({
        taxonomy:  "doc_section",
        node_type: "documentation",
        slug:      slug,
        name:      name
    })
    return !is_error(res)
}

ensure_doc := func(d) {
    res := nodes.query({ node_type: "documentation", slug: d.slug, limit: 1 })
    if !is_error(res) && res.total > 0 {
        return
    }
    n := nodes.create({
        title:        d.title,
        slug:         d.slug,
        node_type:    "documentation",
        status:       "published",
        layout:       "docs",
        excerpt:      d.summary,
        fields_data:  {
            section: { slug: d.section_slug, name: d.section_name },
            summary: d.summary,
            order:   d.order
        },
        seo_settings: {
            meta_title:       d.title + " — Squilla docs",
            meta_description: d.summary
        },
        blocks_data: d.blocks
    })
    if is_error(n) {
        log.warn("[squilla:seed] doc create failed: " + d.slug)
    }
}

export {
    run: func() {
        log.info("[squilla:seed] seeding documentation")

        raw := assets.read("seeds/docs.json")
        if is_error(raw) {
            log.warn("[squilla:seed] could not read seeds/docs.json")
            return
        }

        data := helpers.json_decode(raw)
        if is_undefined(data) {
            log.warn("[squilla:seed] seeds/docs.json failed to parse")
            return
        }

        for t in data.terms {
            ensure_term(t.slug, t.name)
        }

        for d in data.docs {
            ensure_doc(d)
        }
    }
}
